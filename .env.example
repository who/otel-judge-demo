# Public configuration for the otel-judge demo board.
#
# Both values are PUBLIC origins, not credentials. Only VITE_-prefixed names
# reach the client bundle, and src/lib/env.ts refuses to start if any env key
# contains KEY, TOKEN or SECRET. Never put TYPESAFE_API_KEY or any other
# credential here or in the Pages build.
#
# Leave a value unset and the board runs in mock mode.

# Origin of the Judge Worker (Cloudflare Agents SDK).
VITE_API_BASE=https://judge.example.workers.dev

# Origin of the otel-judge-firehose producer used by the emit controls.
VITE_FIREHOSE_BASE=https://firehose.example.workers.dev
